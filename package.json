{
  "name": "react-native-unilist",
  "version": "2.0.0",
  "description": "Fabric-ready virtualized lists, AI chat feeds, cards, and utilities for React Native.",
  "main": "lib/module/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/src/index.d.ts",
  "files": [
    "lib",
    "README.md",
    "LICENSE",
    "llms.txt"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/SamadK01/react-native-unilist.git"
  },
  "keywords": [
    "react-native",
    "flatlist",
    "scrollview",
    "list",
    "unilist"
  ],
  "author": "SamadK01",
  "license": "MIT",
  "devDependencies": {
    "@react-native/babel-preset": "^0.79.7",
    "@types/jest": "^29.5.14",
    "@types/react-test-renderer": "^19.0.0",
    "jest": "^29.7.0",
    "react-native-builder-bob": "^0.40.8",
    "react-test-renderer": "19.0.0",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.76.0"
  },
  "scripts": {
    "prepare": "bob build",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
